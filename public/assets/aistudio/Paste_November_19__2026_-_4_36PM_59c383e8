<script>
  // TMB & TDEE Interactive Calculator
  const weightInput = document.getElementById('input-weight');
  const heightInput = document.getElementById('input-height');
  const ageInput = document.getElementById('input-age');
  const activitySelect = document.getElementById('select-activity');
  const goalButtons = document.querySelectorAll('.goal-btn');

  const valWeight = document.getElementById('val-weight');
  const valHeight = document.getElementById('val-height');
  const valAge = document.getElementById('val-age');
  const resBmr = document.getElementById('res-bmr');
  const resTdee = document.getElementById('res-tdee');
  const resProt = document.getElementById('res-prot');

  let currentGoalDelta = 300;

  function recalculateMetabolism() {
    const w = parseFloat(weightInput.value);
    const h = parseFloat(heightInput.value);
    const a = parseFloat(ageInput.value);
    const act = parseFloat(activitySelect.value);

    // Mifflin-St Jeor (Male baseline)
    const bmr = Math.round(10 * w + 6.25 * h - 5 * a + 5);
    const maintenance = bmr * act;
    const targetCalories = Math.round(maintenance + currentGoalDelta);
    const proteinTarget = Math.round(w * 2.2);

    valWeight.textContent = w;
    valHeight.textContent = h;
    valAge.textContent = a;

    resBmr.textContent = bmr.toLocaleString('pt-BR');
    resTdee.textContent = targetCalories.toLocaleString('pt-BR');
    resProt.textContent = proteinTarget;
  }

  weightInput.addEventListener('input', recalculateMetabolism);
  heightInput.addEventListener('input', recalculateMetabolism);
  ageInput.addEventListener('input', recalculateMetabolism);
  activitySelect.addEventListener('change', recalculateMetabolism);

  goalButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      goalButtons.forEach(b => {
        b.classList.remove('bg-primary-container', 'text-surface-container-lowest', 'font-bold', 'shadow-[0_0_12px_rgba(56,189,248,0.4)]');
        b.classList.add('bg-surface-container-high', 'text-on-surface');
      });
      btn.classList.add('bg-primary-container', 'text-surface-container-lowest', 'font-bold', 'shadow-[0_0_12px_rgba(56,189,248,0.4)]');
      btn.classList.remove('bg-surface-container-high', 'text-on-surface');
      currentGoalDelta = parseFloat(btn.getAttribute('data-delta'));
      recalculateMetabolism();
    });
  });

  // Interactive Water Hydration Tracker
  let currentWater = 2500;
  const targetWater = 3500;
  const waterCurrentEl = document.getElementById('water-current');
  const waterDiffEl = document.getElementById('water-diff');
  const waterPctEl = document.getElementById('water-pct');
  const waterFillLevel = document.getElementById('water-fill-level');

  function updateWaterUI() {
    const pct = Math.min(100, Math.round((currentWater / targetWater) * 100));
    waterCurrentEl.textContent = currentWater.toLocaleString('pt-BR');
    waterPctEl.textContent = pct + '%';
    waterFillLevel.style.height = pct + '%';
    const diff = Math.max(0, targetWater - currentWater);
    waterDiffEl.textContent = diff.toLocaleString('pt-BR') + ' ml';
  }

  document.getElementById('add-water-250').addEventListener('click', () => {
    currentWater = Math.min(currentWater + 250, 6000);
    updateWaterUI();
  });

  document.getElementById('add-water-500').addEventListener('click', () => {
    currentWater = Math.min(currentWater + 500, 6000);
    updateWaterUI();
  });

  // Interactive Meal Check toggles
  const checkButtons = document.querySelectorAll('.meal-check-btn');
  checkButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const isChecked = btn.classList.contains('bg-primary-container');
      const parentCard = btn.closest('.meal-item');
      if (isChecked) {
        btn.classList.remove('bg-primary-container', 'text-surface-container-lowest', 'shadow-[0_0_10px_rgba(56,189,248,0.5)]');
        btn.classList.add('bg-surface-container-highest', 'text-on-surface-variant');
        if (parentCard) parentCard.classList.add('opacity-75');
      } else {
        btn.classList.add('bg-primary-container', 'text-surface-container-lowest', 'shadow-[0_0_10px_rgba(56,189,248,0.5)]');
        btn.classList.remove('bg-surface-container-highest', 'text-on-surface-variant');
        if (parentCard) parentCard.classList.remove('opacity-75');
      }
    });
  });
