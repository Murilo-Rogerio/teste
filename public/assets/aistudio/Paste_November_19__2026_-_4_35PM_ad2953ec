<script>
  function triggerHaptic() {
    if (window.navigator && window.navigator.vibrate) {
      window.navigator.vibrate(15);
    }
  }

  function simulateInstall(btn) {
    triggerHaptic();
    btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Instalando...';
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span> Instalado';
      btn.classList.remove('bg-primary');
      btn.classList.add('bg-surface-container-highest', 'text-on-surface');
      simulateToast('App APEX adicionado ao cache e tela inicial!');
    }, 900);
  }

  function simulateToast(msg) {
    const toast = document.getElementById('apex-toast');
    const label = document.getElementById('apex-toast-msg');
    label.innerText = msg;
    toast.classList.remove('hidden');
    toast.classList.add('flex');
    triggerHaptic();
    setTimeout(() => {
      toast.classList.add('hidden');
      toast.classList.remove('flex');
    }, 2800);
  }

  function switchTab(el, type) {
    triggerHaptic();
    document.querySelectorAll('.tab-chip').forEach(tab => {
      tab.classList.remove('bg-primary', 'text-on-primary', 'font-bold');
      tab.classList.add('bg-surface-container-high', 'text-on-surface-variant');
    });
    el.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
    el.classList.add('bg-primary', 'text-on-primary', 'font-bold');

    const cards = document.querySelectorAll('.workout-card');
    if (type === 'favs') {
      cards.forEach((c, idx) => {
        c.style.display = idx === 0 ? 'flex' : 'none';
      });
      simulateToast('Filtrado por: Favoritos');
    } else {
      cards.forEach(c => c.style.display = 'flex');
      simulateToast('Divisão de treino atualizada');
    }
  }

  function toggleLibrary(show) {
    triggerHaptic();
    const drawer = document.getElementById('exercise-library-drawer');
    if (show) {
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
    } else {
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
    }
  }

  function filterExercises() {
    const query = document.getElementById('exercise-search-input').value.toLowerCase();
    const items = document.querySelectorAll('.exercise-item');
    items.forEach(item => {
      const name = item.getAttribute('data-name');
      if (name.includes(query)) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });
  }

  function selectMuscleGroup(el, group) {
    triggerHaptic();
    document.querySelectorAll('.mg-filter').forEach(btn => {
      btn.classList.remove('bg-primary', 'text-on-primary', 'font-bold');
      btn.classList.add('bg-surface-container-high', 'text-on-surface-variant');
    });
    el.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
    el.classList.add('bg-primary', 'text-on-primary', 'font-bold');

    const items = document.querySelectorAll('.exercise-item');
    items.forEach(item => {
      const itemGroup = item.getAttribute('data-muscle');
      if (group === 'all' || itemGroup === group) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });
  }

  function addExerciseToRoutine(btn, name) {
    triggerHaptic();
    btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span>';
    btn.classList.add('bg-primary', 'text-on-primary');
    btn.classList.remove('text-primary', 'bg-surface-container-lowest');
    simulateToast(name + ' adicionado!');
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">add</span>';
      btn.classList.remove('bg-primary', 'text-on-primary');
      btn.classList.add('text-primary', 'bg-surface-container-lowest');
    }, 1500);
  }

  function openNewRoutineModal() {
    triggerHaptic();
    const m = document.getElementById('new-routine-modal');
    m.classList.remove('hidden');
    m.classList.add('flex');
  }

  function closeNewRoutineModal() {
    triggerHaptic();
    const m = document.getElementById('new-routine-modal');
    m.classList.add('hidden');
    m.classList.remove('flex');
  }

  function adjustCounter(id, delta) {
    triggerHaptic();
    const el = document.getElementById(id);
    if (id === 'target-sets') {
      let val = parseInt(el.innerText) + delta;
      if (val < 1) val = 1;
      if (val > 10) val = 10;
      el.innerText = val;
    } else if (id === 'target-reps') {
      let current = el.innerText;
      if (delta > 0) {
        el.innerText = current === '6-8' ? '8-12' : current === '8-12' ? '12-15' : '15-20';
      } else {
        el.innerText = current === '15-20' ? '12-15' : current === '12-15' ? '8-12' : '6-8';
      }
    } else if (id === 'target-rpe') {
      let val = parseFloat(el.innerText) + delta;
      if (val < 6) val = 6;
      if (val > 10) val = 10;
      el.innerText = val.toFixed(1);
    } else if (id === 'target-rest') {
      let val = parseInt(el.innerText) + delta;
      if (val < 30) val = 30;
      if (val > 300) val = 300;
      el.innerText = val + 's';
    }
  }

  function saveNewRoutine() {
    triggerHaptic();
    const nameInput = document.getElementById('routine-name-input');
    const routineName = nameInput.value.trim() || 'Nova Ficha Personalizada';

    const container = document.getElementById('workout-cards-container');
    const newCard = document.createElement('div');
    newCard.className = 'workout-card bg-surface-container rounded-xl p-space-md shadow-lg flex flex-col gap-space-md transition-all animate-pulse';
    newCard.innerHTML = `
      <div class="flex items-start justify-between gap-space-sm">
        <div class="flex flex-col">
          <div class="flex items-center gap-space-xs">
            <span class="w-6 h-6 rounded-md bg-primary/20 text-primary flex items-center justify-center font-label-caps text-label-caps font-bold">D</span>
            <span class="font-label-caps text-label-caps text-primary uppercase font-bold">RECÉM-CRIADA</span>
          </div>
          <span class="font-headline-md text-headline-md text-on-surface font-bold mt-1">${routineName}</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">Meta: Reps ${document.getElementById('target-reps').innerText} &bull; RPE ${document.getElementById('target-rpe').innerText} &bull; Descanso ${document.getElementById('target-rest').innerText}</span>
        </div>
        <button class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant">
          <span class="material-symbols-outlined text-[18px]">more_vert</span>
        </button>
      </div>
      <button onclick="startWorkoutSession('${routineName}')" class="w-full h-11 bg-primary text-on-primary rounded-xl font-label-interactive text-label-interactive font-bold uppercase shadow-[0_0_12px_rgba(56,189,248,0.3)] flex items-center justify-center gap-1">
        <span class="material-symbols-outlined text-[18px]">play_arrow</span>
        <span>Iniciar Treino</span>
      </button>
    `;

    container.prepend(newCard);
    setTimeout(() => newCard.classList.remove('animate-pulse'), 1000);
    closeNewRoutineModal();
    nameInput.value = '';
    simulateToast('Ficha salva! Pronta para rastrear reps e cargas.');
  }

  function startWorkoutSession(name) {
    triggerHaptic();
    simulateToast('Iniciando: ' + name + '...');
    setTimeout(() => {
      const activeTabBtn = document.querySelector('nav a[data-path="treino-ativo"]');
      if (activeTabBtn) {
        activeTabBtn.click();
      }
    }, 600);
  }

  function previewWorkout(letter) {
    triggerHaptic();
    simulateToast('Carregando grade detalhada do Treino ' + letter);
  }
