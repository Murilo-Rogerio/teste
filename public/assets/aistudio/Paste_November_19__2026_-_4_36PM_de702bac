<div class="rounded-xl rounded-tl-none bg-surface-container-high p-space-sm max-w-[85%] shadow-sm">
<span class="font-label-caps text-label-caps text-primary block mb-0.5">Apex Neural Engine</span>
<p class="font-body-sm text-body-sm text-on-surface">
            Pronto para ajustar seu volume e intensidade. Seus dados de fadiga central indicam 88% de prontidão do SNC. Como posso refinar sua periodização hoje?
          </p>
</div>
</div>
</div>
<!-- Interactive Input Bar -->
<form class="relative flex items-center gap-space-xs pt-1" id="ai-chat-form">
<input autocomplete="off" class="w-full h-12 bg-surface-container-high text-on-surface placeholder:text-on-surface-variant font-body-sm text-body-sm rounded-xl px-space-sm focus:outline-none focus:bg-surface-container-highest transition-colors" id="ai-user-input" placeholder="Pergunte sobre séries, RPE, deload ou periodização..." type="text"/>
<button aria-label="Enviar Pergunta" class="h-12 w-12 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shrink-0 hover:bg-primary transition-all active:scale-95 shadow-md" type="submit">
<span class="material-symbols-outlined text-[20px]">send</span>
</button>
</form>
</div>
</div>
<script>
  (function initAICoachModule() {
    const scanBtn = document.getElementById('scan-stagnation-btn');
    const scanIcon = document.getElementById('scan-icon');
    const scanBtnText = document.getElementById('scan-btn-text');
    const scanProgressBox = document.getElementById('scan-progress-box');
    const scanBar = document.getElementById('scan-bar');
    const scanPerc = document.getElementById('scan-perc');
    const scanStatusLabel = document.getElementById('scan-status-label');
    const stagnationCard = document.getElementById('stagnation-alert-card');

    const chatForm = document.getElementById('ai-chat-form');
    const chatInput = document.getElementById('ai-user-input');
    const chatThread = document.getElementById('chat-thread');
    const promptBtns = document.querySelectorAll('.ai-prompt-btn');

    // Algorithmic scan simulation
    if (scanBtn) {
      scanBtn.addEventListener('click', () => {
        scanBtn.disabled = true;
        scanBtn.classList.add('opacity-75');
        scanProgressBox.classList.remove('hidden');
        scanProgressBox.classList.add('flex');
        scanIcon.classList.add('animate-spin');
        scanBtnText.textContent = 'Processando Modelagem Biomecânica...';
        
        let progress = 0;
        const stages = [
          'Calculando velocidade concêntrica média (VBT)...',
          'Avaliando desaceleração de Reps em Reserva (RIR)...',
          'Cruzando tonelagem com histórico de 21 dias...',
          'Detectando assimetrias na curvatura de força...'
        ];

        const interval = setInterval(() => {
          progress += 5;
          if (progress > 100) progress = 100;

          scanBar.style.width = progress + '%';
          scanPerc.textContent = progress + '%';

          const stageIndex = Math.floor((progress / 100) * stages.length);
          if (stages[stageIndex]) {
            scanStatusLabel.textContent = stages[stageIndex];
          }

          if (progress >= 100) {
            clearInterval(interval);
            setTimeout(() => {
              scanIcon.classList.remove('animate-spin');
              scanBtnText.textContent = 'Varredura Concluída &bull; Platô Mapeado';
              scanBtn.disabled = false;
              scanBtn.classList.remove('opacity-75');
              scanProgressBox.classList.add('hidden');
              scanProgressBox.classList.remove('flex');
              
              // Pulsing highlight effect on the diagnosis card
              stagnationCard.classList.add('animate-pulse');
              setTimeout(() => stagnationCard.classList.remove('animate-pulse'), 1200);
            }, 400);
          }
        }, 60);
      });
    }

    // Knowledge base for conversational simulation
    const coachResponses = {
      supino: 'Para superar o platô de supino: seus dados apontam falha no ponto de transição concêntrica (sticking point a 5cm do peito). Recomendo prescrever 3 semanas de Supino com Pausa de 2 segundos (Spoto Press) a 70% de 1RM e incremento de 15% no volume semanal de tríceps (foco em extensão na polia com corda).',
      deload: 'Análise de Prontidão: Sua tonelagem total semanal atingiu 14.800 kg com RPE médio de 8.8 nos últimos 12 treinos. Você não necessita de um deload passivo total, mas sim um Deload Reativo: reduza as séries totais de 4 para 2 em movimentos compostos por 5 dias, mantendo a intensidade de carga intacta.',
      ombros: 'Para os ombros: o feixe lateral tolera alta frequência devido à proporção de fibras tipo I. Você pode adicionar Elevação Lateral com cabos 3x por semana (3x15 reps) mantendo RPE 8. Isso eleva a resposta de síntese proteica miofibrilar sem sobrecarregar o manguito rotador.',
      padrao: 'Com base nas leis de Hanneman e recrutamento de unidades motoras: para essa adaptação, priorize a cadência concêntrica máxima pretendida (CAT) mantendo RIR entre 1 e 2 repetições. Isso maximizará a tensão mecânica sem exaustão do sistema dopaminérgico.'
    };

    function appendUserMessage(text) {
      const bubble = document.createElement('div');
      bubble.className = 'flex items-start justify-end gap-space-xs';
      bubble.innerHTML = `
        <div class="rounded-xl rounded-tr-none bg-primary p-space-sm max-w-[85%] shadow-sm">
          <span class="font-label-caps text-label-caps text-on-primary-container block mb-0.5 text-right font-bold">Você</span>
          <p class="font-body-sm text-body-sm text-on-primary font-medium">${text}</p>
        </div>
      `;
      chatThread.appendChild(bubble);
      chatThread.scrollTop = chatThread.scrollHeight;
    }

    function appendAITypingAndReply(responseText) {
      const typingBubble = document.createElement('div');
      typingBubble.className = 'flex items-start gap-space-xs';
      typingBubble.id = 'ai-typing-indicator';
      typingBubble.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-primary-container text-on-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[16px]">smart_toy</span>
        </div>
        <div class="rounded-xl rounded-tl-none bg-surface-container-high p-space-sm max-w-[85%] flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
          <span class="font-label-caps text-label-caps text-on-surface-variant">Sintetizando fisiologia do exercício...</span>
        </div>
      `;
      chatThread.appendChild(typingBubble);
      chatThread.scrollTop = chatThread.scrollHeight;

      setTimeout(() => {
        const indicator = document.getElementById('ai-typing-indicator');
        if (indicator) indicator.remove();

        const replyBubble = document.createElement('div');
        replyBubble.className = 'flex items-start gap-space-xs';
        replyBubble.innerHTML = `
          <div class="w-7 h-7 rounded-full bg-primary-container text-on-primary flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[16px]">smart_toy</span>
          </div>
          <div class="rounded-xl rounded-tl-none bg-surface-container-high p-space-sm max-w-[85%] shadow-sm">
            <span class="font-label-caps text-label-caps text-primary block mb-0.5">Apex Neural Engine</span>
            <p class="font-body-sm text-body-sm text-on-surface leading-relaxed">${responseText}</p>
          </div>
        `;
        chatThread.appendChild(replyBubble);
        chatThread.scrollTop = chatThread.scrollHeight;
      }, 750);
    }

    function handleUserSubmission(query) {
      if (!query.trim()) return;
      appendUserMessage(query);

      const q = query.toLowerCase();
      let answer = coachResponses.padrao;
      if (q.includes('supino') || q.includes('platô')) {
        answer = coachResponses.supino;
      } else if (q.includes('deload') || q.includes('semana') || q.includes('descanso')) {
        answer = coachResponses.deload;
      } else if (q.includes('ombro') || q.includes('volume') || q.includes('delt')) {
        answer = coachResponses.ombros;
      }

      appendAITypingAndReply(answer);
    }

    if (chatForm) {
      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = chatInput.value;
        if (text) {
          handleUserSubmission(text);
          chatInput.value = '';
        }
      });
    }

    promptBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const query = btn.getAttribute('data-query');
        if (query) {
          handleUserSubmission(query);
        }
      });
    });
  })();
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface-container-lowest/85 backdrop-blur-xl shadow-[0_-4px_24px_rgba(0,0,0,0.4)]" data-active-classes="text-primary [filter:drop-shadow(0_0_8px_rgba(56,189,248,0.6))]"><div class="flex justify-around items-center h-16 px-space-xs"><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all" data-path="treinos" href="#"><span class="material-symbols-outlined text-[24px]">fitness_center</span><span class="font-label-caps text-label-caps uppercase tracking-wider">Treinos</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all relative" data-path="treino-ativo" href="#"><div class="relative flex items-center justify-center"><span class="material-symbols-outlined text-[24px]">timer</span><span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-primary animate-ping"></span></div><span class="font-label-caps text-label-caps uppercase tracking-wider">Ativo</span></a><a aria-current="page" class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] transition-all text-primary [filter:drop-shadow(0_0_8px_rgba(56,189,248,0.6))]" data-path="ia-coach" href="#"><span class="material-symbols-outlined text-[24px]">smart_toy</span><span class="font-label-caps text-label-caps uppercase tracking-wider">IA Coach</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all" data-path="nutricao" href="#"><span class="material-symbols-outlined text-[24px]">nutrition</span><span class="font-label-caps text-label-caps uppercase tracking-wider">Nutrição</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all" data-path="progresso"