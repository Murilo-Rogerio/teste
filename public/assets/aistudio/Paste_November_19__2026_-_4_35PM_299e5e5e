<!-- Interactive Client-side Logic for Active Telemetry, Timer & Micro-delights -->
<script>
(function() {
  // 1. Elapsed Workout Timer Simulation
  let elapsedSeconds = 28 * 60 + 45;
  const elapsedEl = document.getElementById('elapsed-timer');
  setInterval(() => {
    elapsedSeconds++;
    const mins = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
    const secs = String(elapsedSeconds % 60).padStart(2, '0');
    if (elapsedEl) elapsedEl.textContent = `${mins}:${secs}`;
  }, 1000);

  // 2. Smart Rest Timer Countdown
  let restRemaining = 75; // 01:15
  let totalRestPreset = 90;
  const timerDigits = document.getElementById('timer-digits');
  const timerRing = document.getElementById('timer-progress-ring');
  const maxDash = 264; // 2 * PI * 42 ~= 263.89

  function updateTimerRing() {
    if (!timerDigits || !timerRing) return;
    const mins = String(Math.floor(restRemaining / 60)).padStart(2, '0');
    const secs = String(restRemaining % 60).padStart(2, '0');
    timerDigits.textContent = `${mins}:${secs}`;

    const fraction = restRemaining / totalRestPreset;
    const offset = maxDash * (1 - Math.max(0, Math.min(1, fraction)));
    timerRing.style.strokeDashoffset = offset;
  }

  const timerInterval = setInterval(() => {
    if (restRemaining > 0) {
      restRemaining--;
      updateTimerRing();
    }
  }, 1000);

  // Preset Buttons
  document.querySelectorAll('.timer-preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const s = parseInt(btn.getAttribute('data-seconds'), 10);
      totalRestPreset = s;
      restRemaining = s;
      updateTimerRing();

      // Visual glow highlight
      document.querySelectorAll('.timer-preset-btn').forEach(b => {
        b.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-[0_0_12px_rgba(56,189,248,0.4)]');
        b.classList.add('bg-surface-container-high', 'text-on-surface');
      });
      btn.classList.add('bg-primary-container', 'text-on-primary', 'shadow-[0_0_12px_rgba(56,189,248,0.4)]');
      btn.classList.remove('bg-surface-container-high', 'text-on-surface');
    });
  });

  // +30s Button
  const add30Btn = document.getElementById('btn-add-30s');
  if (add30Btn) {
    add30Btn.addEventListener('click', () => {
      restRemaining += 30;
      totalRestPreset += 30;
      updateTimerRing();
    });
  }

  // Skip Rest
  const skipBtn = document.getElementById('btn-skip-rest');
  if (skipBtn) {
    skipBtn.addEventListener('click', () => {
      restRemaining = 0;
      updateTimerRing();
    });
  }

  // Audio Toggle
  const soundBtn = document.getElementById('timer-sound-toggle');
  const soundIcon = document.getElementById('sound-icon');
  let soundEnabled = true;
  if (soundBtn && soundIcon) {
    soundBtn.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      soundIcon.textContent = soundEnabled ? 'volume_up' : 'volume_off';
      soundBtn.classList.toggle('text-on-surface-variant', !soundEnabled);
      soundBtn.classList.toggle('text-primary', soundEnabled);
    });
  }

  // 3. Interactive Weight & Reps Stepper
  const weightVal = document.getElementById('weight-val');
  const repsVal = document.getElementById('reps-val');
  const weightInc = document.getElementById('weight-inc');
  const weightDec = document.getElementById('weight-dec');
  const repsInc = document.getElementById('reps-inc');
  const repsDec = document.getElementById('reps-dec');

  if (weightInc && weightDec && weightVal) {
    weightInc.addEventListener('click', () => {
      let w = parseFloat(weightVal.textContent) || 0;
      weightVal.textContent = (w + 2).toFixed(0);
    });
    weightDec.addEventListener('click', () => {
      let w = parseFloat(weightVal.textContent) || 0;
      if (w > 2) weightVal.textContent = (w - 2).toFixed(0);
    });
  }

  if (repsInc && repsDec && repsVal) {
    repsInc.addEventListener('click', () => {
      let r = parseInt(repsVal.textContent, 10) || 0;
      repsVal.textContent = r + 1;
    });
    repsDec.addEventListener('click', () => {
      let r = parseInt(repsVal.textContent, 10) || 0;
      if (r > 1) repsVal.textContent = r - 1;
    });
  }

  // 4. Interactive Set Completion & Neon Spark Confetti
  const completeBtn = document.getElementById('complete-set-btn');
  const activeSetRow = document.getElementById('active-set-row');
  const totalVolumeEl = document.getElementById('total-volume');
  let setCompleted = false;

  if (completeBtn && activeSetRow) {
    completeBtn.addEventListener('click', () => {
      setCompleted = !setCompleted;
      if (setCompleted) {
        completeBtn.classList.remove('bg-surface-container', 'text-primary');
        completeBtn.classList.add('bg-primary-container', 'text-on-primary', 'scale-105');
        document.getElementById('complete-set-icon').textContent = 'check';

        // Update Total Volume Dynamically
        const w = parseFloat(weightVal.textContent) || 84;
        const r = parseInt(repsVal.textContent, 10) || 8;
        const addedVol = w * r;
        if (totalVolumeEl) {
          totalVolumeEl.textContent = (4820 + addedVol).toLocaleString('pt-BR') + ' kg';
        }

        // Trigger Rest Timer
        restRemaining = 90;
        totalRestPreset = 90;
        updateTimerRing();

        // Local Storage Offline Save
        try {
          const workoutRecord = {
            exercise: 'Supino Reto com Barra',
            set: 3,
            weight: w,
            reps: r,
            timestamp: new Date().toISOString()
          };
          localStorage.setItem('apex_active_set_3', JSON.stringify(workoutRecord));
        } catch(e) {}
      } else {
        completeBtn.classList.add('bg-surface-container', 'text-primary');
        completeBtn.classList.remove('bg-primary-container', 'text-on-primary', 'scale-105');
      }
    });
  }

  // 5. Dismiss PR banner
  const dismissPR = document.getElementById('dismiss-pr');
  const prToast = document.getElementById('pr-celebration-toast');
  if (dismissPR && prToast) {
    dismissPR.addEventListener('click', () => {
      prToast.classList.add('opacity-0', '-translate-y-4');
      setTimeout(() => prToast.remove(), 400);
    });
  }

  // Micro Confetti Particle Generation
  const confettiContainer = document.getElementById('confetti-container');
  if (confettiContainer) {
    for (let i = 0; i < 18; i++) {
      const p = document.createElement('div');
      p.className = 'absolute rounded-full pointer-events-none opacity-80';
      p.style.width = (Math.random() * 4 + 3) + 'px';
      p.style.height = (Math.random() * 4 + 3) + 'px';
      p.style.backgroundColor = i % 2 === 0 ? '#38bdf8' : '#b4c5ff';
      p.style.left = (Math.random() * 100) + '%';
      p.style.top = (Math.random() * 100) + '%';
      p.style.transform = `scale(${Math.random() * 1.5})`;
      confettiContainer.appendChild(p);
    }
  }

  // 6. Finish Workout Flow Feedback
  const finishButtons = [document.getElementById('btn-finish-top'), document.getElementById('btn-finish-bottom')];
  finishButtons.forEach(btn => {
    if (!btn) return;
    btn.addEventListener('click', () => {
      const confirmed = window.confirm('Deseja concluir o Treino A e registrar o volume total no seu histórico?');
      if (confirmed) {
        btn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span> Gravando...';
        setTimeout(() => {
          alert('Treino concluído com sucesso! 5.492 kg de volume total e +180 XP adicionados.');
          window.location.hash = '#progresso';
        }, 800);
      }
    });
  });

})();
