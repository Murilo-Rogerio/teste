<script>
  (function initApexProgressTelemetry() {
    // 1RM Calculation Logic
    const weightInput = document.getElementById('calc-weight');
    const repsInput = document.getElementById('calc-reps');
    const resEpley = document.getElementById('result-epley');
    const resBrzycki = document.getElementById('result-brzycki');

    function calculate1RM() {
      const w = parseFloat(weightInput.value) || 0;
      const r = parseFloat(repsInput.value) || 1;

      if (w <= 0 || r <= 0) return;

      // Epley Formula: 1RM = W * (1 + r / 30)
      const epley = w * (1 + (r / 30));
      // Brzycki Formula: 1RM = W / (1.0278 - (0.0278 * r))
      const brzycki = r < 37 ? (w / (1.0278 - (0.0278 * r))) : epley;

      resEpley.textContent = `${epley.toFixed(1)} kg`;
      resBrzycki.textContent = `${brzycki.toFixed(1)} kg`;
    }

    if (weightInput && repsInput) {
      weightInput.addEventListener('input', calculate1RM);
      repsInput.addEventListener('input', calculate1RM);
    }

    // Modal Control: 1RM Calculator
    const openCalcBtn = document.getElementById('open-calculator-modal-btn');
    const closeCalcBtn = document.getElementById('close-calculator-btn');
    const applyCalcBtn = document.getElementById('apply-calc-btn');
    const calcModal = document.getElementById('calculator-modal');

    function toggleCalcModal(show) {
      if (calcModal) {
        if (show) {
          calcModal.classList.remove('hidden');
          calculate1RM();
        } else {
          calcModal.classList.add('hidden');
        }
      }
    }

    if (openCalcBtn) openCalcBtn.addEventListener('click', () => toggleCalcModal(true));
    if (closeCalcBtn) closeCalcBtn.addEventListener('click', () => toggleCalcModal(false));
    if (applyCalcBtn) applyCalcBtn.addEventListener('click', () => toggleCalcModal(false));

    // Modal Control: Export Data
    const exportTrigger = document.getElementById('export-trigger-btn');
    const exportModal = document.getElementById('export-modal');
    const closeExportBtn = document.getElementById('close-export-btn');
    const exportJsonAction = document.getElementById('export-json-action');
    const exportCsvAction = document.getElementById('export-csv-action');
    const exportToast = document.getElementById('export-status-toast');

    function toggleExportModal(show) {
      if (exportModal) {
        if (show) exportModal.classList.remove('hidden');
        else {
          exportModal.classList.add('hidden');
          if (exportToast) exportToast.classList.add('hidden');
        }
      }
    }

    if (exportTrigger) exportTrigger.addEventListener('click', () => toggleExportModal(true));
    if (closeExportBtn) closeExportBtn.addEventListener('click', () => toggleExportModal(false));

    function triggerMockExport(type) {
      if (exportToast) {
        exportToast.classList.remove('hidden');
        exportToast.classList.add('flex');
        setTimeout(() => {
          toggleExportModal(false);
        }, 1800);
      }
    }

    if (exportJsonAction) exportJsonAction.addEventListener('click', () => triggerMockExport('JSON'));
    if (exportCsvAction) exportCsvAction.addEventListener('click', () => triggerMockExport('CSV'));

    // Interactive Chart Telemetry Node Inspection
    const nodes = document.querySelectorAll('svg circle[data-val]');
    const tooltipDisplay = document.getElementById('chart-tooltip-display');

    nodes.forEach(node => {
      node.addEventListener('click', function() {
        const val = this.getAttribute('data-val');
        if (tooltipDisplay && val) {
          tooltipDisplay.innerHTML = `<span class="material-symbols-outlined text-primary text-[16px] mr-1.5">query_stats</span> Tonelagem Registrada: <strong class="text-primary ml-1">${val}</strong>`;
        }
      });
    });

    // Chart Time Horizon Tabs (Semanal, Mensal, Anual)
    const periodButtons = document.querySelectorAll('.period-btn');
    const chartSubLabel = document.getElementById('chart-sub-label');
    const chartLine = document.getElementById('chart-line');
    const chartArea = document.getElementById('chart-area');

    const chartDatasets = {
      semanal: {
        label: 'Volume total acumulado (6 últimas semanas)',
        linePath: 'M 20,95 L 75,76 L 130,68 L 180,118 L 240,54 L 305,32',
        areaPath: 'M 20,95 L 75,76 L 130,68 L 180,118 L 240,54 L 305,32 L 305,150 L 20,150 Z'
      },
      mensal: {
        label: 'Média de volume por microciclo mensal (kg)',
        linePath: 'M 20,110 L 75,90 L 130,75 L 180,85 L 240,45 L 305,25',
        areaPath: 'M 20,110 L 75,90 L 130,75 L 180,85 L 240,45 L 305,25 L 305,150 L 20,150 Z'
      },
      anual: {
        label: 'Progressão macroanual de sobrecarga linear (kg)',
        linePath: 'M 20,130 L 75,115 L 130,95 L 180,75 L 240,50 L 305,20',
        areaPath: 'M 20,130 L 75,115 L 130,95 L 180,75 L 240,50 L 305,20 L 305,150 L 20,150 Z'
      }
    };

    periodButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const period = this.getAttribute('data-period');
        periodButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'font-bold');
          b.classList.add('text-on-surface-variant');
        });
        this.classList.add('bg-primary', 'text-on-primary', 'font-bold');
        this.classList.remove('text-on-surface-variant');

        if (chartDatasets[period]) {
          if (chartSubLabel) chartSubLabel.textContent = chartDatasets[period].label;
          if (chartLine) chartLine.setAttribute('d', chartDatasets[period].linePath);
          if (chartArea) chartArea.setAttribute('d', chartDatasets[period].areaPath);
        }
      });
