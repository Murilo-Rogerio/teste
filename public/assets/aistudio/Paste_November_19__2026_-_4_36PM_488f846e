    const sendBtn = document.getElementById('send-chat-btn');
    const messagesContainer = document.getElementById('chat-messages');
    const typingIndicator = document.getElementById('ai-typing-indicator');
    const voiceBtn = document.getElementById('voice-input-btn');
    const micIcon = document.getElementById('mic-icon');
    const micWave = document.getElementById('mic-wave');
    const voiceStatus = document.getElementById('voice-status');
    const clearInputBtn = document.getElementById('clear-input-btn');
    const quickPills = document.querySelectorAll('.quick-pill');
    const modeButtons = document.querySelectorAll('#mode-selector button');
    const applyWeightBtn = document.getElementById('apply-weight-btn');

    let currentMode = 'biomechanic';
    let isRecording = false;

    // Respostas simuladas inteligentes de acordo com palavras-chave e modo
    const knowledgeBase = [
      {
        triggers: ['ombro', 'estalo', 'dor no ombro', 'estalo no supino'],
        response: `**Avaliação Biomecânica de Estalo no Ombro:**
Um estalo súbito indolor geralmente decorre de subluxação transitória do tendão do bíceps no sulco intertubercular ou cavitação glenoumeral. 
Se houver dor em pontada ou perda de estabilidade:
1. Reduza imediatamente a amplitude nos últimos 3cm do peitoral (evite hiperabdução horizontal).
2. Retraia e deprima ativamente as escápulas ("empurre os ombros para os bolsos de trás").
3. Mude a pegada para 1.5x a largura biacromial ou substitua pelo Supino com Halteres em pegada neutra/semipronada.`
      },
      {
        triggers: ['aumentar', '2kg', 'reps', '+2kg', 'sobrecarga'],
        response: `**Princípio da Sobrecarga Progressiva Apex:**
Se na última série você atingiu o topo da faixa de repetições estipulada com **RPE menor ou igual a 8 (2+ RIR)**:
- **Exercícios Compostos:** Aumente 2kg no peso total se seu objetivo for força e tensão mecânica.
- **Isoladores:** Prefira acumular 1 a 2 repetições adicionais com a carga atual antes de subir peso, garantindo controle excêntrico de 3 segundos.`
      },
      {
        triggers: ['agachamento', 'lombar', 'costas', 'trocar', 'substituir'],
        response: `**Substituição para Poupar Coluna Lombar:**
Para manter estímulo intenso no quadríceps sem sobrecarga axial compressiva:
1. **Agachamento Búlgaro (Rear Foot Elevated Split Squat):** 80% menos carga sobre as vértebras lombares L4-L5 e hipertrofia equivalente.
2. **Leg Press 45° com apoio de quadril colado:** Zero cisalhamento anterior da coluna lombar.
3. **Agachamento Hack:** Apoio torácico fixo com vetor direcionado exclusivamente aos joelhos.`
      },
      {
        triggers: ['comer', 'pre-treino', '45min', 'pernas', 'dieta', 'nutricao'],
        response: `**Janela Pré-Treino de Pernas (T-45 min):**
Para evitar sequestro de fluxo sanguíneo mesentérico e garantir glicemia rápida:
- **Carboidrato de rápida assimilação:** 40g (ex: banana madura amassada com 2 colheres de mel ou 30g de maltodextrina/farinha de arroz).
- **Proteína:** 15g a 20g de Whey Isolado ou Hidrolisado (baixo esvaziamento gástrico).
- **Gorduras e Fibras:** ZERO. Evite pasta de amendoim ou aveia pesada agora para não gerar náusea nos agachamentos.`
      },
      {
        triggers: ['deload', 'semana', 'cansaco', 'fadiga', 'descanso'],
        response: `**Critérios de Acionamento do Deload:**
Recomendo Deload quando você preencher 2 dos 3 critérios da telemetria:
1. **Perda de rendimento:** Falha em atingir as repetições mínimas por 2 sessões seguidas no mesmo grupo muscular.
2. **Qualidade do sono & RPE:** RPE percebido subindo >1 ponto em cargas submáximas.
3. **Volume Acumulado:** Passou de 5 a 6 semanas de mesociclo hipertrófico progressivo.
*Protocolo de Deload Apex:* Mantenha as cargas, mas reduza o volume de séries em 50% durante 7 dias.`
      }
    ];

    // Alternar Modos
    modeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        modeButtons.forEach(b => {
          b.className = 'flex-1 py-1.5 rounded-lg text-center font-label-caps text-label-caps uppercase transition-all duration-200 text-on-surface-variant hover:text-on-surface font-semibold';
        });
        btn.className = 'flex-1 py-1.5 rounded-lg text-center font-label-caps text-label-caps uppercase transition-all duration-200 bg-primary text-on-primary font-bold shadow-[0_0_12px_rgba(56,189,248,0.3)]';
        currentMode = btn.getAttribute('data-mode');
      });
    });

    // Quick Pills
    quickPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const text = pill.getAttribute('data-prompt');
        chatInput.value = text;
        submitMessage(text);
      });
    });

    // Input Events
    chatInput.addEventListener('input', () => {
      clearInputBtn.classList.toggle('hidden', chatInput.value.length === 0);
    });

    clearInputBtn.addEventListener('click', () => {
      chatInput.value = '';
      clearInputBtn.classList.add('hidden');
      chatInput.focus();
    });

    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const text = chatInput.value.trim();
        if (text) submitMessage(text);
      }
    });

    sendBtn.addEventListener('click', () => {
      const text = chatInput.value.trim();
      if (text) submitMessage(text);
    });

    // Voice Simulation
    voiceBtn.addEventListener('click', () => {
      isRecording = !isRecording;
      if (isRecording) {
        voiceBtn.classList.add('bg-error', 'text-on-error');
        micIcon.textContent = 'mic_off';
        micWave.classList.remove('hidden');
        voiceStatus.classList.remove('hidden');
        chatInput.placeholder = "Ouvindo sua voz com cancelamento de ruído...";
        
        // Simular final de transcrição após 3 segundos
        setTimeout(() => {
          if (isRecording) {
            isRecording = false;
            voiceBtn.classList.remove('bg-error', 'text-on-error');
            micIcon.textContent = 'mic';
            micWave.classList.add('hidden');
            voiceStatus.classList.add('hidden');
            chatInput.placeholder = "Pergunte ao Gemini Coach (ex: biomecânica, RPE)...";
            chatInput.value = "Minha lombar está fadigada após a terceira série de agachamento.";
            submitMessage(chatInput.value);
          }
        }, 2800);
      } else {
        voiceBtn.classList.remove('bg-error', 'text-on-error');
        micIcon.textContent = 'mic';
        micWave.classList.add('hidden');
        voiceStatus.classList.add('hidden');
        chatInput.placeholder = "Pergunte ao Gemini Coach (ex: biomecânica, RPE)...";
      }
    });

    // Enviar Mensagem do Usuário e Gerar Resposta Gemini
    function submitMessage(text) {
      chatInput.value = '';
      clearInputBtn.classList.add('hidden');

      // 1. Inserir bolha do Usuário
      const userBubble = document.createElement('div');
      userBubble.className = 'flex items-start justify-end gap-space-sm self-end max-w-[88%] animate-fade-in';
      userBubble.innerHTML = `
        <div class="flex flex-col items-end gap-1">
          <div class="flex items-center gap-2">
            <span class="font-label-caps text-label-caps text-on-surface-variant">Agora</span>
            <span class="font-headline-sm text-body-sm text-on-surface font-semibold">Você</span>
          </div>
          <div class="bg-secondary-container text-on-secondary-container p-space-md rounded-2xl rounded-tr-sm shadow-md">
            <p class="font-body-md text-body-md">${escapeHtml(text)}</p>
          </div>
        </div>
        <div class="w-8 h-8 rounded-full bg-surface-container-highest flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-on-surface text-[18px]">person</span>
        </div>
      `;
      messagesContainer.appendChild(userBubble);
      scrollToBottom();

      // 2. Mostrar indicador de pensamento Gemini
      typingIndicator.classList.remove('hidden');
      typingIndicator.classList.add('flex');
      messagesContainer.appendChild(typingIndicator);
      scrollToBottom();

      // 3. Processar resposta
      setTimeout(() => {
        typingIndicator.classList.add('hidden');
        typingIndicator.classList.remove('flex');
        generateAIResponse(text);
      }, 1100);
    }

    function generateAIResponse(userText) {
      const lower = userText.toLowerCase();
      let matched = knowledgeBase.find(k => k.triggers.some(t => lower.includes(t)));

      let contentHtml = '';
      if (matched) {
        contentHtml = formatMarkdown(matched.response);
      } else {
        // Resposta genérica contextual com modo
        if (currentMode === 'quick') {
          contentHtml = `<p class="font-body-md text-body-md"><strong>Orientação Direta:</strong> Mantenha a cadência de 2 segundos na descida, concentre a força no ponto de contração e finalize a série com 1 repetição de reserva (RIR 1). Hidrate-se agora com 200ml de água.</p>`;
        } else if (currentMode === 'nutrition') {
          contentHtml = `<p class="font-body-md text-body-md"><strong>Análise Nutricional:</strong> Para acelerar a ressíntese de fosfocreatina e diminuir danos musculares da sessão atual, garanta ingestão pós-treino com 0.4g de proteína de alto valor biológico por kg corporal combinada com carboidratos de índice glicêmico moderado.</p>`;
        } else {
          contentHtml = `<p class="font-body-md text-body-md">Com base no seu modelo biomecânico e nos 84kg registrados na série anterior, sua relação trabalho/descanso está em 1:2.5. Para otimizar o recrutamento fibrilar sem dissipar torque articular, certifique-se de que o trajeto do movimento preserva a linha de ação da gravidade sobre o músculo-alvo.</p>`;
        }
      }

      const aiBubble = document.createElement('div');
      aiBubble.className = 'flex items-start gap-space-sm max-w-[95%] animate-fade-in';
      aiBubble.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-secondary-container to-primary flex items-center justify-center shrink-0 shadow-[0_0_10px_rgba(56,189,248,0.4)]">
          <span class="material-symbols-outlined text-surface text-[18px]" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
        </div>
        <div class="flex flex-col gap-1.5 w-full">
          <div class="flex items-center gap-2">
            <span class="font-headline-sm text-body-sm text-primary font-bold">Apex Gemini Coach</span>
            <span class="font-label-caps text-label-caps text-on-surface-variant">Agora</span>
          </div>
          <div class="bg-surface-container-high text-on-surface p-space-md rounded-2xl rounded-tl-sm shadow-lg flex flex-col gap-space-sm">
            ${contentHtml}
            <div class="flex items-center justify-between pt-2 border-t border-outline-variant/20 mt-1">
              <span class="font-label-caps text-label-caps text-on-surface-variant">Modo: ${currentMode.toUpperCase()}</span>
              <div class="flex items-center gap-2">
                <button class="text-on-surface-variant hover:text-primary transition-colors text-body-sm" title="Útil"><span class="material-symbols-outlined text-[16px]">thumb_up</span></button>
                <button class="text-on-surface-variant hover:text-error transition-colors text-body-sm" title="Não ajudou"><span class="material-symbols-outlined text-[16px]">thumb_down</span></button>
              </div>
            </div>
          </div>
        </div>
      `;
      messagesContainer.appendChild(aiBubble);
      scrollToBottom();
    }

    // Botão de aplicar carga
    if (applyWeightBtn) {
      applyWeightBtn.addEventListener('click', () => {
        applyWeightBtn.textContent = '80kg Aplicado!';
        applyWeightBtn.classList.remove('bg-primary', 'text-on-primary');
        applyWeightBtn.classList.add('bg-secondary-container', 'text-on-secondary-container');
        
        // Disparar feedback de toast haptic
        const toast = document.createElement('div');
        toast.className = 'fixed top-20 left-1/2 -translate-x-1/2 bg-primary text-on-primary px-space-md py-2 rounded-full font-label-caps text-label-caps font-bold shadow-[0_0_16px_rgba(56,189,248,0.5)] z-50 flex items-center gap-1.5';
        toast.innerHTML = '<span class="material-symbols-outlined text-[16px]">check_circle</span> SÉRIE 4 ATUALIZADA NO LOG (80KG)';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2500);
      });
    }

    function scrollToBottom() {
      window.scrollTo({
        top: document.body.scrollHeight,
        behavior: 'smooth'
      });
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[m]);
    }

    function formatMarkdown(text) {
      let formatted = text
        .replace(/\*\*(.*?)\*\*/g, '<strong class="text-on-surface">$1</strong>')
        .replace(/\n/g, '<br/>');
      return `<div class="font-body-md text-body-md text-on-surface-variant leading-relaxed">${formatted}</div>`;
    }
  })();
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface-container-lowest/85 backdrop-blur-xl shadow-[0_-4px_24px_rgba(0,0,0,0.5)] border-t border-white/[0.04]" data-active-classes="text-primary [filter:drop-shadow(0_0_8px_rgba(56,189,248,0.6))] font-bold"><div class="flex justify-around items-center h-16 px-space-xs"><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all" data-path="treinos-fichas" href="#"><span class="material-symbols-outlined text-[24px]">fitness_center</span><span class="font-label-caps text-label-caps uppercase tracking-wider">Treinos</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all relative" data-path="treino-ativo" href="#"><div class="relative flex items-center justify-center"><span class="material-symbols-outlined text-[24px]">timer</span><span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-primary animate-ping"></span></div><span class="font-label-caps text-label-caps uppercase tracking-wider">Ativo</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all" data-path="ia-coach-gemini-assistant" href="#"><span class="material-symbols-outlined text-[24px]">smart_toy</span><span class="font-label-caps text-label-caps uppercase tracking-wider">IA Coach</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface transition-all" data-path="nutricao-macros" href="#"><span class="material-symbols-outlined text-[24px]">nutrition</span><span class="font-label-caps text-label-caps uppercase tracking-wider">Nutrição</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-on-surface-variant hover:text-on-surface trans